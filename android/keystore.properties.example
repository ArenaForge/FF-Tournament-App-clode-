# Copy this file to "keystore.properties" (same folder) and fill in
# your real values. keystore.properties is already gitignored — never
# commit your real keystore path/passwords.
#
# Generate an upload keystore first if you don't have one:
#   keytool -genkeypair -v -keystore ff-max-arena-upload.keystore \
#     -alias ff-max-arena -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the android/ directory.
storeFile=../ff-max-arena-upload.keystore
storePassword=CHANGE_ME
keyAlias=ff-max-arena
keyPassword=CHANGE_ME
